{
  "short_name": "ApplyMate",
  "name": "ApplyMate - Personal Job Application Assistant",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "192x192 512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/",
  "background_color": "#F5F7FC",
  "theme_color": "#4F46E5",
  "display": "standalone",
  "orientation": "portrait",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_image",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  }
}
